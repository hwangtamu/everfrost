rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One save document per account: players/{uid}.
    match /players/{uid} {
      allow read: if signedIn(uid);
      allow create: if signedIn(uid) && validSave() && request.resource.data.revision == 1;
      allow update: if signedIn(uid) && validSave() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      function signedIn(uid) {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        return request.resource.data.keys().hasOnly(['version', 'revision', 'payload', 'updatedAt'])
          && request.resource.data.version == 1
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 1000000
          && request.resource.data.updatedAt is timestamp;
      }
    }
  }
}
